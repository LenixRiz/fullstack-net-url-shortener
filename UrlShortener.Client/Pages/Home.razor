@page "/"
@using System.Net.Http.Json
@using System.Runtime.CompilerServices
@using System.Text.Json
@using UrlShortener.Client.DTOs
@using UrlShortener.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>URL Shortener</PageTitle>

<div class="container py-5" style="max-width: 700px;">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">URL Shortener</h1>
        <p class="text-muted">Create short link with high performance and instant analytics.</p>
    </div>
    
    <!-- Card Form Input -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <EditForm Model="@requestModel" OnValidSubmit="HandleShortenUrl">
                <DataAnnotationsValidator />

                <div class="input-group mb-2">
                    <InputText @bind-Value="requestModel.LongUrl"
                               class="form-control form-control-lg"
                               placeholder="Paste your link here..." />
                    <button class="btn btn-primary px-4 fw-semibold" type="submit" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Shorten</span>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => requestModel.LongUrl)" class="text-danger small"/>
            </EditForm>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 py-2" role="alert">
                    @errorMessage
                </div>
            }
        </div>
    </div>

    <!-- Result card -->
    @if (result is not null)
    {
        <div class="card border-success shadow-sm">
            <div class="card-body p-4">
                <h6 class="card-subtitle mb-2 text-success fw-bold">Link successfully created!</h6>
                <div class="input-group my-3">
                <input type="text" class="form-control bg-light" value="@result.ShortUrl" readonly />

                <button class="btn btn-outline-primary"
                    type="button"
                    @onclick="() => CopyToClipboard(result.ShortUrl)">
                        @(copiedUrl == result.ShortUrl ? "Copied!" : "Copy")
                    </button>

                <a href="@result.ShortUrl" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn btn-outline-secondary">
                    Visit
                </a>
            </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted text-truncate" style="max-width: 400px;">
                        Target: @result.OriginalUrl
                    </small>
                    <a href="@($"/stats/{result.ShortCode}")" class="btn btn-sm btn-link text-decoration-none">
                        Statistic &rarr;
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- History -->
    @if (historyList.Count > 0)
    {
        <div class="card shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">History</h5>
                <button class="btn btn-sm btn-outline-danger" @onclick="ClearHistory">
                    Delete All
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb=0">
                    <thead class="table-light">
                        <tr>
                            <th>Original URL</th>
                            <th>Short URL</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in historyList)
                        {
                            <tr>
                                <td class="text-truncate" style="max-width: 250px;" title="@item.OriginalUrl">
                                    @item.OriginalUrl
                                </td>
                                <td>
                                    <a href="@item.ShortUrl" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none">
                                        @item.ShortUrl
                                    </a>
                                </td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-light border me-1" @onclick="() => CopyToClipboard(item.ShortUrl)">
                                        @(copiedUrl == item.ShortUrl ? "✓" : "Copy")
                                    </button>
                                    <a href="@($"/stats/{item.ShortCode}")" class="btn btn-sm btn-primary">
                                        Statistic
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private ShortenUrlRequest requestModel = new();
    private ShortenUrlResponse? result;
    private List<UrlHistoryItem> historyList = new();
    private bool isLoading = false;
    private string copiedUrl = string.Empty;
    private string? errorMessage;

    private const string StorageKey = "url_shortener_history";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadHistoryFromStorage();
            StateHasChanged();
        }
    }

    private async Task HandleShortenUrl()
    {
        isLoading = true;
        errorMessage = null;
        result = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/shorten", requestModel);

            if (response.IsSuccessStatusCode)
            {
                result = await response.Content.ReadFromJsonAsync<ShortenUrlResponse>();

                if (result != null)
                {
                    await AddToHistory(result);
                    requestModel = new ShortenUrlRequest();
                }
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                errorMessage = errorObj != null && errorObj.TryGetValue("error", out var msg)
                    ? msg
                    : "Failed to create short link.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection problem: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadHistoryFromStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                historyList = JsonSerializer.Deserialize<List<UrlHistoryItem>>(json) ?? new();
            }
        }
        catch (Exception)
        {
            historyList = new();
        }
    }

    private async Task AddToHistory(ShortenUrlResponse newItem)
    {
        historyList.Insert(0, new UrlHistoryItem
        {
            ShortCode = newItem.ShortCode,
            ShortUrl = newItem.ShortUrl,
            OriginalUrl = newItem.OriginalUrl,
            CreatedAt = DateTime.UtcNow
        });

        if (historyList.Count > 20)
        {
            historyList = historyList.Take(20).ToList();
        }

        var json = JsonSerializer.Serialize(historyList);
        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
    }

    private async Task ClearHistory()
    {
        historyList.Clear();
        await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copiedUrl = text;
            StateHasChanged();

            await Task.Delay(2000);
            copiedUrl = string.Empty;
            StateHasChanged();
        }
        catch (Exception)
        {
            errorMessage = "Failed to copy into clipboard.";
        }
    }
}