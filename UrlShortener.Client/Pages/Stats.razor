@page "/stats/{code}"
@using System.Net.Http.Json
@using UrlShortener.Shared
@using UrlShortener.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Statistic - @Code</PageTitle>

<div class="container py-4" style="max-width: 850px;">
    <button class="btn btn-outline-secondary btn-sm mb-4" @onclick="GoBack">
        &larr; Back to Home
    </button>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading data...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm" role="alert">
            @errorMessage
        </div>
    }
    else if (stats is not null)
    {
        <!-- Header Summary -->
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <span class="badge bg-primary-subtle text-primary mb-2">Kode: @stats.ShortCode</span>
                        <h5 class="fw-bold mb-1 text-truncate" title="@stats.LongUrl">
                            @stats.LongUrl
                        </h5>
                        <small class="text-muted">Dibuat pada: @stats.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") WIB</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 bg-primary text-white">
                    <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                        <span class="small opacity-75">Total Visit</span>
                        <h2 class="display-6 fw-bold mb-0">@stats.TotalClicks</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Graphic -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Last 7 Days Visit Trend</h6>
                
                @if (stats.DailyClicks.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">No visit in last 7 days.</p>
                    </div>
                }
                else
                {
                    <div style="height: 300px; position: relative;">
                        <canvas id="dailyClicksCanvas"></canvas>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private UrlStatsResponse? stats;
    private bool isLoading = true;
    private string? errorMessage;
    private bool shouldRenderChart = false;

   protected override async Task OnParametersSetAsync()
    {
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            stats = await Http.GetFromJsonAsync<UrlStatsResponse>($"api/stats/{Code}");

            if (stats is not null && stats.DailyClicks.Count > 0)
            {
                shouldRenderChart = true;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "Statistic data for this code is not available."
                : "Failed to fetch data from the server.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Something is wrong: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (shouldRenderChart && stats is not null)
    {
        shouldRenderChart = false;

        try
        {
            var labels = stats.DailyClicks
                .Select(d => d.Date.ToString("dd MMM"))
                .ToArray();

            var counts = stats.DailyClicks
                .Select(d => d.Count)
                .ToArray();

            await JS.InvokeVoidAsync("renderDailyClicksChart", "dailyClicksCanvas", labels, counts);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load graphic: {ex.Message}";
            StateHasChanged();
        }
    }
}
    private void GoBack()
    {
        Nav.NavigateTo("/");
    }
}