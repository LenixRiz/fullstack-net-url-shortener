FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY ["UrlShortener.Shared/UrlShortener.Shared.csproj", "UrlShortener.Shared/"]
COPY ["UrlShortener.Client/UrlShortener.Client.csproj", "UrlShortener.Client/"]
RUN dotnet restore "UrlShortener.Client/UrlShortener.Client.csproj"

COPY . .
WORKDIR "/src/UrlShortener.Client"
RUN dotnet publish "UrlShortener.Client.csproj" -c Release -o /app/publish

# Gunakan Nginx ringan untuk menyajikan file statis WASM
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /app/publish/wwwroot .
COPY nginx-blazor.conf /etc/nginx/conf.d/default.conf
EXPOSE 80